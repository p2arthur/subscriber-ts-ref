{
  "entryPoints": ["src/index.ts"],
  "plugin": ["typedoc-plugin-markdown"],
  "outputs": [
    { "name": "html", "path": "docs/_html" },
    { "name": "markdown", "path": "docs/code" }
  ],
  "navigationLinks": {
    "Examples": "./examples/index.html"
  },
  "cleanOutputDir": true,
  "excludePrivate": true,
  "excludeProtected": true,
  "highlightLanguages": ["typescript", "python", "json", "bash", "js", "yaml"],
  "excludeReferences": true,
  "includeHierarchySummary": true
}
